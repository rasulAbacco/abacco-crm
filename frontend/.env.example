# Usually leave unset: the app calls /api/v1 on its own origin (Vite proxy in
# development, Render rewrite in production). Set only to call the API directly.
# VITE_API_URL=https://abacco-api.onrender.com/api/v1
# For `npm run dev` when the API is not on localhost:4000:
# VITE_DEV_API=http://localhost:4000
