// =============================================================================
// Abacco CRM — Prisma schema (PostgreSQL)
//
// Conventions
//  * Every timestamp is timestamptz and stored in UTC (process TZ=UTC).
//  * Every sales record carries accountId + ownerWorkspaceId (the Sales ID).
//  * Money is stored as integer minor units (BigInt) + ISO-4217 currency.
//  * Soft-deleted rows have deletedAt set; uniqueness ignores them (partial indexes).
//  * Emails are matched on emailNormalized (trimmed + lower-cased).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------- enums

enum WorkspaceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TimezoneSource {
  EXPLICIT
  PHONE
  COUNTRY
  DEFAULT
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskType {
  TODO
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STATUS_CHANGE
  SHARE
  TRANSFER
  SYSTEM
}

enum ShareableEntity {
  LEAD
  CONTACT
  COMPANY
  DEAL
}

enum SharePermission {
  READ
  COLLABORATE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
}

enum SmtpProvider {
  GMAIL
  REDIFFMAIL
  ZOHO
  YAHOO
  AMAZON_SES
  CUSTOM
}

enum SmtpSecurity {
  SSL
  STARTTLS
  NONE
}

enum SmtpAuthType {
  PASSWORD
  OAUTH2
}

enum SmtpHealth {
  UNTESTED
  HEALTHY
  UNHEALTHY
  AUTH_FAILED
}

enum UsageWindow {
  HOUR
  DAY
}

enum ListMemberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  REMOVED
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBED
  MANUAL
  ERASURE
  INVALID
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum LegalRegime {
  GDPR
  UK_GDPR
  CASL
  CAN_SPAM
  DPDP
  SPAM_ACT
  OTHER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
  SUPPRESSED
  UNSUBSCRIBED
  SKIPPED
  CANCELLED
}

enum ScheduleMode {
  IMMEDIATE
  FIXED_TIME
  RECIPIENT_LOCAL
}

enum PastTimeBehaviour {
  SEND_NOW
  NEXT_DAY
  SKIP
}

enum EmailEventType {
  ACCEPTED
  DELIVERED
  BOUNCED_HARD
  BOUNCED_SOFT
  COMPLAINED
  OPENED
  CLICKED
  UNSUBSCRIBED
  FAILED
  REJECTED
}

enum EventSource {
  SMTP
  SES_SNS
  IMAP_BOUNCE
  TRACKING_PIXEL
  LINK_REDIRECT
  UNSUBSCRIBE_LINK
  LIST_UNSUBSCRIBE_POST
  MANUAL
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTrigger {
  LEAD_CREATED
  CONTACT_CREATED
  LIST_JOINED
  LEAD_STATUS_CHANGED
  DATE_FIELD
  CAMPAIGN_EVENT
  MANUAL
}

enum AutomationStepType {
  SEND_EMAIL
  WAIT
  CONDITION
  CREATE_TASK
  UPDATE_FIELD
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXITED
  FAILED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ImportEntity {
  LEAD
  CONTACT
  COMPANY
  LIST_MEMBER
}

// ----------------------------------------------------------------------------- identity

model Account {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  defaultCurrency String   @default("INR") @db.Char(3)
  defaultTimezone String   @default("Asia/Kolkata")
  defaultLocale   String   @default("en-IN")
  legalName       String?
  postalAddress   String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  users          User[]
  workspaces     SalesWorkspace[]
  leads          Lead[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  pipelines      Pipeline[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  tags           Tag[]
  customFields   CustomFieldDefinition[]
  shares         RecordShare[]
  transfers      RecordTransferHistory[]
  auditLogs      AuditLog[]
  smtpAccounts   SmtpAccount[]
  emailLists     EmailList[]
  templates      EmailTemplate[]
  suppressions   Suppression[]
  unsubscribes   Unsubscribe[]
  consents       ConsentRecord[]
  countries      CountryProfile[]
  holidays       Holiday[]
  campaigns      Campaign[]
  emailEvents    EmailEvent[]
  automations    Automation[]
  notifications  Notification[]
  systemSettings SystemSetting[]
  importJobs     ImportJob[]

  @@map("accounts")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @db.Uuid
  email             String    @unique
  passwordHash      String
  name              String
  timezone          String?
  locale            String?
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  lastLoginAt       DateTime? @db.Timestamptz(3)
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  createdShares RecordShare[]           @relation("ShareCreatedBy")
  transfers     RecordTransferHistory[]
  notes         Note[]
  activities    Activity[]
  campaigns     Campaign[]
  importJobs    ImportJob[]

  @@index([accountId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  revokeReason String?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------- Sales IDs (workspaces)

model SalesWorkspace {
  id                     String          @id @default(uuid()) @db.Uuid
  accountId              String          @db.Uuid
  code                   String // e.g. SID-001, unique per account, never reused
  name                   String
  description            String?
  status                 WorkspaceStatus @default(ACTIVE)
  isDefault              Boolean         @default(false)
  color                  String?
  defaultCurrency        String?         @db.Char(3) // falls back to Account.defaultCurrency
  defaultTimezone        String? // falls back to Account.defaultTimezone
  senderLegalName        String? // required in campaign footers before sending
  senderPostalAddress    String?
  // Campaigns send from the main email by default; the alternate is chosen explicitly.
  primarySmtpAccountId   String?         @db.Uuid
  alternateSmtpAccountId String?         @db.Uuid
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?       @db.Timestamptz(3)

  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  primarySmtp     SmtpAccount?            @relation("WorkspacePrimarySmtp", fields: [primarySmtpAccountId], references: [id], onDelete: SetNull)
  alternateSmtp   SmtpAccount?            @relation("WorkspaceAlternateSmtp", fields: [alternateSmtpAccountId], references: [id], onDelete: SetNull)
  settings        SalesWorkspaceSettings?
  leads           Lead[]
  contacts        Contact[]
  companies       Company[]
  deals           Deal[]
  pipelines       Pipeline[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]
  sharesOut       RecordShare[]           @relation("ShareOwner")
  sharesIn        RecordShare[]           @relation("ShareTarget")
  transfersOut    RecordTransferHistory[] @relation("TransferFrom")
  transfersIn     RecordTransferHistory[] @relation("TransferTo")
  smtpAssignments SmtpAccountWorkspace[]
  emailLists      EmailList[]
  templates       EmailTemplate[]
  campaigns       Campaign[]
  automations     Automation[]
  auditLogs       AuditLog[]
  importJobs      ImportJob[]
  emailEvents     EmailEvent[]
  unsubscribes    Unsubscribe[]

  @@unique([accountId, code])
  @@unique([accountId, name], map: "sales_workspaces_account_name_live_key", where: raw("\"deletedAt\" IS NULL"))
  @@unique([accountId], map: "sales_workspaces_one_default_key", where: raw("\"isDefault\" = true AND \"deletedAt\" IS NULL"))
  @@index([accountId, status])
  @@map("sales_workspaces")
}

model SalesWorkspaceSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @unique @db.Uuid
  businessHoursStart String   @default("09:00") // local HH:mm
  businessHoursEnd   String   @default("18:00")
  businessDays       Int[]    @default([1, 2, 3, 4, 5]) // ISO weekday 1=Mon … 7=Sun
  emailFooterHtml    String?
  leadScoringRules   Json?
  preferences        Json?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  workspace SalesWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sales_workspace_settings")
}

// ----------------------------------------------------------------------------- sales CRM

model Company {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  ownerWorkspaceId String    @db.Uuid
  name             String
  nameNormalized   String
  domain           String?
  website          String?
  industry         String?
  size             String?
  email            String?
  phoneE164        String?
  phoneRaw         String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postalCode       String?
  countryCode      String?   @db.Char(2)
  timezone         String?
  description      String?
  customFields     Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]

  @@unique([ownerWorkspaceId, nameNormalized], map: "companies_workspace_name_live_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([accountId, ownerWorkspaceId, deletedAt])
  @@index([ownerWorkspaceId, countryCode])
  @@index([domain])
  @@map("companies")
}

model Contact {
  id               String         @id @default(uuid()) @db.Uuid
  accountId        String         @db.Uuid
  ownerWorkspaceId String         @db.Uuid
  companyId        String?        @db.Uuid
  firstName        String?
  lastName         String?
  email            String?
  emailNormalized  String?
  phoneE164        String?
  phoneRaw         String?
  ccEmails         String[]       @default([]) // copied on every campaign email to this contact
  subjectLine      String? // this client's email subject; campaigns reuse it via {{subjectLine}}
  designation      String?
  countryCode      String?        @db.Char(2)
  region           String?
  city             String?
  timezone         String?
  timezoneSource   TimezoneSource @default(DEFAULT)
  locale           String?
  source           String?
  description      String?
  customFields     Json?
  lastContactedAt  DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?      @db.Timestamptz(3)

  account         Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace  SalesWorkspace         @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  company         Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  convertedLeads  Lead[]
  deals           Deal[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]
  listMemberships EmailListContact[]
  consents        ConsentRecord[]
  campaignRecips  CampaignRecipient[]
  enrollments     AutomationEnrollment[]

  @@unique([ownerWorkspaceId, emailNormalized], map: "contacts_workspace_email_live_key", where: raw("\"deletedAt\" IS NULL AND \"emailNormalized\" IS NOT NULL"))
  @@index([accountId, ownerWorkspaceId, deletedAt])
  @@index([ownerWorkspaceId, countryCode])
  @@index([accountId, emailNormalized])
  @@index([companyId])
  @@map("contacts")
}

model Lead {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String         @db.Uuid
  ownerWorkspaceId  String         @db.Uuid
  companyId         String?        @db.Uuid
  contactId         String?        @db.Uuid // set when converted
  firstName         String?
  lastName          String?
  fullName          String
  email             String?
  emailNormalized   String?
  phoneE164         String?
  phoneRaw          String?
  companyName       String?
  designation       String?
  website           String?
  countryCode       String?        @db.Char(2)
  region            String?
  city              String?
  timezone          String?
  timezoneSource    TimezoneSource @default(DEFAULT)
  locale            String?
  source            String?
  status            LeadStatus     @default(NEW)
  priority          Priority       @default(MEDIUM)
  score             Int            @default(0)
  description       String?
  customFields      Json?
  convertedAt       DateTime?      @db.Timestamptz(3)
  lastActivityAt    DateTime?      @db.Timestamptz(3)
  // Sales follow-up (matches the team's Excel tracker). Status lists are editable per account.
  responseStatus    String? // e.g. Active, Not Responding, Responded, Budget, Leave Out
  callStatus        String? // e.g. Not Called, Left Voicemail, Call Connected
  callNotes         String?
  previousPitch     String?
  followUpPitch     String?
  ccEmails          String[]       @default([]) // "CC Mail": copied on campaign emails to this lead
  subjectLine       String? // this client's email subject; follow-ups reuse it via {{subjectLine}}
  priceCurrency     String?        @db.Char(3)
  basicPriceMinor   BigInt? // typed by the user; never calculated or converted
  premiumPriceMinor BigInt?
  dataCount         Int?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?      @db.Timestamptz(3)

  account        Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace         @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  company        Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact        Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  enrollments    AutomationEnrollment[]

  @@index([accountId, ownerWorkspaceId, deletedAt, createdAt])
  @@index([ownerWorkspaceId, status])
  @@index([ownerWorkspaceId, responseStatus])
  @@index([ownerWorkspaceId, source])
  @@index([ownerWorkspaceId, countryCode])
  @@index([accountId, emailNormalized])
  @@map("leads")
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace SalesWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@unique([workspaceId, name])
  @@map("pipelines")
}

model PipelineStage {
  id          String    @id @default(uuid()) @db.Uuid
  pipelineId  String    @db.Uuid
  name        String
  position    Int
  probability Int       @default(0) // 0-100
  kind        StageKind @default(OPEN)
  color       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  accountId         String     @db.Uuid
  ownerWorkspaceId  String     @db.Uuid
  pipelineId        String     @db.Uuid
  stageId           String     @db.Uuid
  leadId            String?    @db.Uuid
  contactId         String?    @db.Uuid
  companyId         String?    @db.Uuid
  title             String
  amountMinor       BigInt     @default(0) // entered manually; never converted
  currency          String     @db.Char(3)
  probability       Int? // overrides stage probability when set
  expectedCloseDate DateTime?  @db.Date
  status            DealStatus @default(OPEN)
  closedAt          DateTime?  @db.Timestamptz(3)
  lostReason        String?
  position          Float      @default(0) // ordering within a Kanban column
  description       String?
  customFields      Json?
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?  @db.Timestamptz(3)

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  pipeline       Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks          Task[]
  notes          Note[]
  activities     Activity[]

  @@index([accountId, ownerWorkspaceId, deletedAt])
  @@index([ownerWorkspaceId, status, currency])
  @@index([stageId, position])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@map("deals")
}

model Task {
  id               String     @id @default(uuid()) @db.Uuid
  accountId        String     @db.Uuid
  ownerWorkspaceId String     @db.Uuid
  title            String
  description      String?
  type             TaskType   @default(TODO)
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  dueAt            DateTime?  @db.Timestamptz(3)
  remindAt         DateTime?  @db.Timestamptz(3)
  reminderSentAt   DateTime?  @db.Timestamptz(3)
  completedAt      DateTime?  @db.Timestamptz(3)
  leadId           String?    @db.Uuid
  contactId        String?    @db.Uuid
  companyId        String?    @db.Uuid
  dealId           String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([accountId, ownerWorkspaceId, status, dueAt])
  @@index([remindAt, reminderSentAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("tasks")
}

// Notes and activities hang off exactly one parent record (enforced by a CHECK
// constraint in the migration). They move with their parent on transfer.
model Note {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @db.Uuid
  workspaceId String    @db.Uuid // Sales ID in which the note was written
  authorId    String?   @db.Uuid
  body        String
  leadId      String?   @db.Uuid
  contactId   String?   @db.Uuid
  companyId   String?   @db.Uuid
  dealId      String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace SalesWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@map("notes")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  accountId   String       @db.Uuid
  workspaceId String       @db.Uuid
  actorId     String?      @db.Uuid
  type        ActivityType
  subject     String
  body        String?
  metadata    Json?
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  leadId      String?      @db.Uuid
  contactId   String?      @db.Uuid
  companyId   String?      @db.Uuid
  dealId      String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace SalesWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([accountId, workspaceId, occurredAt])
