  targetWorkspace SalesWorkspace @relation("ShareTarget", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, targetWorkspaceId])
