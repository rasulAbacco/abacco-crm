  toWorkspace   SalesWorkspace @relation("TransferTo", fields: [toWorkspaceId], references: [id], onDelete: Restrict)
  performedBy   User?          @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([accountId, entityType, entityId, createdAt])
