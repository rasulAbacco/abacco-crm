}

model RecordTransferHistory {
  id              String          @id @default(uuid()) @db.Uuid
  accountId       String          @db.Uuid
  entityType      ShareableEntity
  entityId        String          @db.Uuid
  fromWorkspaceId String          @db.Uuid
  toWorkspaceId   String          @db.Uuid
  cascaded        Json? // { tasks: n, deals: n, ... }
  reason          String?
  performedById   String?         @db.Uuid
