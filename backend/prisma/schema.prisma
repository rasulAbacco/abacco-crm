model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  userId      String?  @db.Uuid
  workspaceId String?  @db.Uuid
  action      String // e.g. lead.create, record.share, record.transfer, smtp.test
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace SalesWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([accountId, entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------- email infrastructure

model SmtpAccount {
  id                   String       @id @default(uuid()) @db.Uuid
  accountId            String       @db.Uuid
  name                 String
  fromEmail            String
  fromName             String?
  provider             SmtpProvider
  host                 String
  port                 Int
  security             SmtpSecurity
  authType             SmtpAuthType @default(PASSWORD)
  username             String
  // AES-256-GCM encrypted JSON ({ password } or { clientId, clientSecret, refreshToken }).
  credentialCiphertext String
  credentialIv         String
  credentialTag        String
  credentialKeyVersion Int          @default(1)
  sesRegion            String?
  hourlyLimit          Int
  dailyLimit           Int
  isEnabled            Boolean      @default(true)
  health               SmtpHealth   @default(UNTESTED)
  unhealthyUntil       DateTime?    @db.Timestamptz(3)
  consecutiveFailures  Int          @default(0)
  lastTestedAt         DateTime?    @db.Timestamptz(3)
  lastError            String?
  lastUsedAt           DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?    @db.Timestamptz(3)

  account      Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaces   SmtpAccountWorkspace[]
  primaryFor   SalesWorkspace[]       @relation("WorkspacePrimarySmtp")
  alternateFor SalesWorkspace[]       @relation("WorkspaceAlternateSmtp")
  usage        SmtpUsageWindow[]
  campaigns    CampaignSmtpAccount[]
  recipients   CampaignRecipient[]
  events       EmailEvent[]
  automations  Automation[]

  @@unique([accountId, fromEmail], map: "smtp_accounts_account_from_live_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([accountId, isEnabled, health])
  @@map("smtp_accounts")
}

model SmtpAccountWorkspace {
  smtpAccountId String   @db.Uuid
  workspaceId   String   @db.Uuid
  assignedAt    DateTime @default(now()) @db.Timestamptz(3)

  smtpAccount SmtpAccount    @relation(fields: [smtpAccountId], references: [id], onDelete: Cascade)
  workspace   SalesWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([smtpAccountId, workspaceId])
  @@index([workspaceId])
  @@map("smtp_account_workspaces")
}

// Durable mirror of the Redis rate counters (Redis is the fast path).
model SmtpUsageWindow {
  smtpAccountId String      @db.Uuid
  window        UsageWindow
  windowStart   DateTime    @db.Timestamptz(3)
  sentCount     Int         @default(0)
  failedCount   Int         @default(0)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  smtpAccount SmtpAccount @relation(fields: [smtpAccountId], references: [id], onDelete: Cascade)

  @@id([smtpAccountId, window, windowStart])
  @@map("smtp_usage_windows")
}

model EmailList {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  ownerWorkspaceId String    @db.Uuid
  name             String
  description      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace     @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  members        EmailListContact[]
  campaigns      CampaignList[]

  @@unique([ownerWorkspaceId, name], map: "email_lists_workspace_name_live_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([accountId, ownerWorkspaceId])
  @@map("email_lists")
}

model EmailListContact {
  listId         String           @db.Uuid
  contactId      String           @db.Uuid
  status         ListMemberStatus @default(SUBSCRIBED)
  source         String?
  addedAt        DateTime         @default(now()) @db.Timestamptz(3)
  unsubscribedAt DateTime?        @db.Timestamptz(3)

  list    EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@index([listId, status])
  @@map("email_list_contacts")
}

model EmailTemplate {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  ownerWorkspaceId String?   @db.Uuid // null = available to every Sales ID
  name             String
  subject          String?
  preheader        String?
  html             String
  text             String?
  design           Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace? @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  campaigns      Campaign[]

  @@index([accountId, ownerWorkspaceId])
  @@map("email_templates")
}

// Account-wide: a suppressed address is never mailed from any Sales ID.
model Suppression {
  id              String            @id @default(uuid()) @db.Uuid
  accountId       String            @db.Uuid
  emailNormalized String? // nulled on erasure; emailHash keeps the block
  emailHash       String // sha256(emailNormalized)
  reason          SuppressionReason
  source          EventSource       @default(MANUAL)
  countryCode     String?           @db.Char(2)
  note            String?
  campaignId      String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, emailHash])
  @@index([accountId, reason])
  @@map("suppressions")
}

model Unsubscribe {
  id              String      @id @default(uuid()) @db.Uuid
  accountId       String      @db.Uuid
  emailNormalized String?
  emailHash       String
  workspaceId     String?     @db.Uuid
  campaignId      String?     @db.Uuid
  recipientId     String?     @db.Uuid
  source          EventSource
  countryCode     String?     @db.Char(2)
  ip              String?
  userAgent       String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace SalesWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([accountId, emailHash])
  @@index([campaignId])
  @@map("unsubscribes")
}

model ConsentRecord {
  id              String        @id @default(uuid()) @db.Uuid
  accountId       String        @db.Uuid
  contactId       String?       @db.Uuid
  emailNormalized String?
  emailHash       String
  status          ConsentStatus
  legalBasis      String? // consent, legitimate_interest, existing_customer …
  source          String? // web_form, import, manual, event …
  countryCode     String?       @db.Char(2)
  evidence        Json?
  capturedAt      DateTime      @default(now()) @db.Timestamptz(3)
  withdrawnAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([accountId, emailHash, capturedAt])
  @@index([contactId])
  @@map("consent_records")
}

model CountryProfile {
  id                   String      @id @default(uuid()) @db.Uuid
  accountId            String      @db.Uuid
  code                 String      @db.Char(2) // ISO 3166-1 alpha-2
  name                 String
  defaultTimezone      String
  legalRegime          LegalRegime @default(OTHER)
  requiresPriorConsent Boolean     @default(false)
  businessHoursStart   String      @default("09:00")
  businessHoursEnd     String      @default("18:00")
  businessDays         Int[]       @default([1, 2, 3, 4, 5])
  currency             String?     @db.Char(3)
  notes                String?
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@map("country_profiles")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  countryCode String   @db.Char(2)
  date        DateTime @db.Date
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, countryCode, date])
  @@map("holidays")
}

// ----------------------------------------------------------------------------- campaigns

model Campaign {
  id                   String            @id @default(uuid()) @db.Uuid
  accountId            String            @db.Uuid
  ownerWorkspaceId     String            @db.Uuid
  templateId           String?           @db.Uuid
  createdById          String?           @db.Uuid
  name                 String
  description          String?
  status               CampaignStatus    @default(DRAFT)
  statusReason         String?
  subject              String?
  preheader            String?
  fromName             String?
  fromEmail            String?
  replyTo              String?
  html                 String?
  text                 String?
  segmentFilter        Json?
  trackOpens           Boolean           @default(true)
  trackClicks          Boolean           @default(true)
  scheduleMode         ScheduleMode      @default(IMMEDIATE)
  scheduledAtUtc       DateTime?         @db.Timestamptz(3)
  localSendDate        DateTime?         @db.Date
  localSendTime        String? // HH:mm in the recipient's zone
  fallbackTimezone     String?
  pastTimeBehaviour    PastTimeBehaviour @default(NEXT_DAY)
  respectBusinessHours Boolean           @default(false)
  includeCc            Boolean           @default(true) // copy each contact's CC addresses
  // Pitch price is typed by the user; the app never calculates or converts it.
  pitchAmountMinor     BigInt?
  pitchCurrency        String?           @db.Char(3)
  pitchPriceNote       String?
  startedAt            DateTime?         @db.Timestamptz(3)
  completedAt          DateTime?         @db.Timestamptz(3)
  cancelledAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?         @db.Timestamptz(3)

  account        Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace        @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  template       EmailTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lists          CampaignList[]
  smtpAccounts   CampaignSmtpAccount[]
  recipients     CampaignRecipient[]
  events         EmailEvent[]
  links          TrackedLink[]

  @@index([accountId, ownerWorkspaceId, status])
  @@index([status, scheduledAtUtc])
  @@map("campaigns")
}

model CampaignList {
  campaignId String @db.Uuid
  listId     String @db.Uuid

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list     EmailList @relation(fields: [listId], references: [id], onDelete: Restrict)

  @@id([campaignId, listId])
  @@map("campaign_lists")
}

model CampaignSmtpAccount {
  campaignId    String @db.Uuid
  smtpAccountId String @db.Uuid
  weight        Int    @default(1)

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  smtpAccount SmtpAccount @relation(fields: [smtpAccountId], references: [id], onDelete: Restrict)

  @@id([campaignId, smtpAccountId])
  @@map("campaign_smtp_accounts")
}

// Source of truth for sending. A row moves PENDING → QUEUED → SENDING → SENT
// (or FAILED / SKIPPED / SUPPRESSED / CANCELLED); BOUNCED and UNSUBSCRIBED are
// applied later from events. The unique key makes double-sending impossible.
model CampaignRecipient {
  id                String          @id @default(uuid()) @db.Uuid
  campaignId        String          @db.Uuid
  contactId         String?         @db.Uuid
  email             String
  emailNormalized   String
  mergeData         Json? // snapshot of firstName, lastName, company … at enqueue time
  ccEmails          String[]        @default([]) // snapshot of the contact's CC addresses
  countryCode       String?         @db.Char(2)
  recipientTimezone String?
  scheduledAtUtc    DateTime?       @db.Timestamptz(3)
  status            RecipientStatus @default(PENDING)
  skipReason        String?
  smtpAccountId     String?         @db.Uuid
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?       @db.Timestamptz(3)
  lockedAt          DateTime?       @db.Timestamptz(3)
  lockedBy          String?
  messageId         String?
  trackingToken     String          @unique
  lastError         String?
  queuedAt          DateTime?       @db.Timestamptz(3)
  sentAt            DateTime?       @db.Timestamptz(3)
  firstOpenedAt     DateTime?       @db.Timestamptz(3)
  firstClickedAt    DateTime?       @db.Timestamptz(3)
  bouncedAt         DateTime?       @db.Timestamptz(3)
  unsubscribedAt    DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  smtpAccount SmtpAccount? @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)
  events      EmailEvent[]

  @@unique([campaignId, emailNormalized])
  @@index([campaignId, status, scheduledAtUtc])
  @@index([status, scheduledAtUtc])
  @@index([status, lockedAt])
  @@index([messageId])
  @@map("campaign_recipients")
}

model EmailEvent {
  id               String         @id @default(uuid()) @db.Uuid
  accountId        String         @db.Uuid
  workspaceId      String?        @db.Uuid
  campaignId       String?        @db.Uuid
  recipientId      String?        @db.Uuid
  smtpAccountId    String?        @db.Uuid
  automationExecId String?        @db.Uuid
  type             EmailEventType
  source           EventSource
  dedupeKey        String         @unique
  providerEventId  String?
  url              String?
  isMachine        Boolean        @default(false) // e.g. Apple MPP / scanner prefetch
  ip               String?
  userAgent        String?
  metadata         Json?
  occurredAt       DateTime       @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace   SalesWorkspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  campaign    Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  smtpAccount SmtpAccount?       @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)

  @@index([campaignId, type, occurredAt])
  @@index([accountId, type, occurredAt])
  @@index([workspaceId, type, occurredAt])
  @@index([smtpAccountId, type, occurredAt])
  @@index([recipientId])
  @@map("email_events")
}

model TrackedLink {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  url        String
  urlHash    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, urlHash])
  @@map("tracked_links")
}

// ----------------------------------------------------------------------------- automation

model Automation {
  id               String            @id @default(uuid()) @db.Uuid
  accountId        String            @db.Uuid
  ownerWorkspaceId String            @db.Uuid
  smtpAccountId    String?           @db.Uuid
  name             String
  description      String?
  status           AutomationStatus  @default(DRAFT)
  triggerType      AutomationTrigger
  triggerConfig    Json?
  allowReentry     Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)

  account        Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerWorkspace SalesWorkspace         @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Restrict)
  smtpAccount    SmtpAccount?           @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)
  steps          AutomationStep[]
  enrollments    AutomationEnrollment[]

  @@index([accountId, ownerWorkspaceId, status])
  @@index([triggerType, status])
  @@map("automations")
}

model AutomationStep {
  id           String             @id @default(uuid()) @db.Uuid
  automationId String             @db.Uuid
  position     Int
  type         AutomationStepType
  config       Json
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  automation Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([automationId, position])
  @@map("automation_steps")
}

model AutomationEnrollment {
  id              String           @id @default(uuid()) @db.Uuid
  automationId    String           @db.Uuid
  contactId       String?          @db.Uuid
  leadId          String?          @db.Uuid
  emailNormalized String
  dedupeKey       String           @unique // automationId:email[:cycle]
  status          EnrollmentStatus @default(ACTIVE)
  currentPosition Int              @default(0)
  nextRunAt       DateTime?        @db.Timestamptz(3)
  exitReason      String?
  enrolledAt      DateTime         @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)

  automation Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  executions AutomationExecution[]

  @@index([status, nextRunAt])
  @@index([automationId, status])
  @@map("automation_enrollments")
}

model AutomationExecution {
  id             String          @id @default(uuid()) @db.Uuid
  enrollmentId   String          @db.Uuid
  stepId         String          @db.Uuid
  idempotencyKey String          @unique // enrollmentId:stepId
  status         ExecutionStatus @default(PENDING)
  attempts       Int             @default(0)
  messageId      String?
  error          String?
  startedAt      DateTime?       @db.Timestamptz(3)
  finishedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  enrollment AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       AutomationStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status, createdAt])
  @@map("automation_executions")
}

// ----------------------------------------------------------------------------- misc

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model SystemSetting {
  accountId String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("system_settings")
}

model ImportJob {
  id            String       @id @default(uuid()) @db.Uuid
  accountId     String       @db.Uuid
  workspaceId   String       @db.Uuid
  createdById   String?      @db.Uuid
  entityType    ImportEntity
  targetListId  String?      @db.Uuid
  fileName      String
  status        ImportStatus @default(PENDING)
  mapping       Json?
  options       Json?
  totalRows     Int          @default(0)
  processedRows Int          @default(0)
  createdCount  Int          @default(0)
  updatedCount  Int          @default(0)
  skippedCount  Int          @default(0)
  errorCount    Int          @default(0)
  errors        Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace SalesWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, workspaceId, createdAt])
  @@map("import_jobs")
}
