# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TZ=UTC

# PostgreSQL (docker-compose default) — Render injects this from the database.
DATABASE_URL=postgresql://abacco:abacco@localhost:5432/abacco_crm
DATABASE_POOL_MAX=10

# Redis / Render Key Value (must run with maxmemory-policy=noeviction for BullMQ)
REDIS_URL=redis://localhost:6379

# Public URLs
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0                 # set 1 on Render

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SAMESITE=strict        # keep strict; serve web + API from the same site
# One-time first-run setup through the UI (POST /api/v1/auth/setup). Remove after setup.
SETUP_TOKEN=

# SMTP credential encryption — generate with:
#   node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotation: append "2:<new key>" and set ENCRYPTION_ACTIVE_KEY_VERSION=2. Never delete a key still in use.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_VERSION=1

# System mail for password resets (Mailpit from docker-compose in development).
SYSTEM_SMTP_HOST=localhost
SYSTEM_SMTP_PORT=1025
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_MAIL_FROM="Abacco CRM <no-reply@example.com>"

# Worker (npm run worker)
WORKER_SEND_CONCURRENCY=4
# Amazon SES → SNS → POST {API_PUBLIC_URL}/webhooks/ses (optional allow-list of topic ARNs)
SES_SNS_TOPIC_ARNS=
