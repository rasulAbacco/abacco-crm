{
  "name": "abacco-crm-backend",
  "version": "1.0.0",
  "description": "Abacco Sales CRM + Email Marketing CRM — API and workers",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "create-admin": "node --env-file-if-exists=.env scripts/createAdmin.js",
    "reset-password": "node --env-file-if-exists=.env scripts/resetPassword.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "worker": "node src/workers/workerBootstrap.js",
    "worker:dev": "node --watch --env-file-if-exists=.env src/workers/workerBootstrap.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "sanitize-html": "^2.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
